{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "User",
    "description": "Schema for user documents in Firestore",
    "type": "object",
    "properties": {
          "created_time": { "description": "Time the user was created", "type": "string", "format": "date-time" },
          "display_name": { "description": "The display name of the user", "type": "string" },
          "email": { "description": "The email address of the user", "type": "string", "format": "email" },
          "photo_url": { "description": "URL of the user's profile photo", "type": "string", "format": "uri" },
          "phone_number": { "description": "The user's phone number", "type": "string" },
          "uid": { "description": "The unique identifier of the user", "type": "string" },
          "hometown": { "description": "Custom field: user's hometown", "type": "string" }
    },
    "required": ["created_time", "display_name", "email", "uid"]
}
